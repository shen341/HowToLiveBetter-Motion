# Muse API 接入配置
MUSE_API_KEY=your_muse_api_key_here
MUSE_BASE_URL=https://yourselfai.org/muse/v1

# 模型定义
MODEL_TEXT=muse-spark
MODEL_IMAGE=muse-image
MODEL_VIDEO=muse-video

# TTS 语音生成配置 (Cloudflare Worker Edge-TTS)
TTS_API_URL=https://tts-voice-magic.shimizuhiro874-28e.workers.dev/v1/audio/speech
TTS_VOICE=zh-CN-YunzeNeural
TTS_SPEED=1.0
TTS_PITCH=0
TTS_STYLE=general

# 视频产物配置
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# 批量生成速率控制与重试配置 (TASK-4.3)
RATE_LIMIT_MUSE_RPM=30
RATE_LIMIT_TTS_RPM=60
API_MAX_RETRIES=3
API_RETRY_DELAY=2.0

# 社交平台发布码率预设 (TASK-4.4: default / xhs / douyin / wechat / bilibili)
PLATFORM_PRESET=default

