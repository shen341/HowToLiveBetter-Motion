# ==============================================================================
# AI 架构演进与运行时模式 (ADR-015)
# 可选值:
# - hybrid: (强烈推荐) 云端Gemini 3.8 Flash High文案(0.0001元极速无重复) + 本地RTX 4070 ComfyUI高清原画(0成本) + 免费Edge-TTS
# - local:  全离线本地化 (本地 Ollama 文案 + 本地 ComfyUI 原画)
# - cloud:  全云端多模态
# ==============================================================================
AI_MODE=hybrid


# ------------------------------------------------------------------------------
# 阶段一: 本地大模型配置 (Ollama / OpenAI 兼容接口)
# ------------------------------------------------------------------------------
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5vl:7b
LOCAL_LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# 阶段二: 解说语音 TTS 配置 (Cloudflare Worker Edge-TTS)
# 注: 依据 ADR-015 改造决策，解说语音使用免费高保真 Edge-TTS，无论 local 或 cloud 均无需本地化部署
# ------------------------------------------------------------------------------
TTS_API_URL=https://tts-voice-magic.shimizuhiro874-28e.workers.dev/v1/audio/speech
TTS_VOICE=zh-CN-YunzeNeural
TTS_SPEED=1.0
TTS_PITCH=0
TTS_STYLE=general

# ------------------------------------------------------------------------------
# 阶段三: 本地艺术原画与画风 LoRA 扩散配置 (ComfyUI API / RTX 4070 适配)
# ------------------------------------------------------------------------------
LOCAL_IMAGE_BACKEND=comfyui
LOCAL_COMFYUI_URL=http://127.0.0.1:8188
LOCAL_IMAGE_CHECKPOINT=sd_xl_base_1.0.safetensors
LOCAL_IMAGE_STEPS=20
LOCAL_IMAGE_CFG=7.0
LOCAL_IMAGE_SAMPLER=euler_ancestral
LOCAL_IMAGE_SCHEDULER=karras
LOCAL_IMAGE_TIMEOUT_SECONDS=180.0
# 可选：自定义 ComfyUI 导出的 API 格式工作流 json 文件路径
# LOCAL_COMFYUI_WORKFLOW=workflows/comfyui_sdxl_lora_workflow.json

# ------------------------------------------------------------------------------
# 云端主线路配置 (Muse API 接入)
# ------------------------------------------------------------------------------
MUSE_API_KEY=your_muse_api_key_here
MUSE_BASE_URL=https://yourselfai.org/muse/v1
MODEL_TEXT=muse-spark
MODEL_IMAGE=muse-image
MODEL_VIDEO=muse-video

# ------------------------------------------------------------------------------
# 容灾备选路线配置 (OpenAI 兼容协议 - YourselfAI / Gemini)
# ------------------------------------------------------------------------------
YOURSELFAI_API_KEY=your_yourselfai_api_key_here
YOURSELFAI_BASE_URL=https://yourselfai.org/v1
YOURSELFAI_MODEL=gemini-3.8-flash-high
YOURSELFAI_IMAGE_MODEL=gemini-3.1-flash-image

# 接口超时控制 (防止服务端拥堵导致无限挂起, 默认: 180.0 秒)
API_TIMEOUT_SECONDS=180.0

# 视频产物配置
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# 批量生成速率控制与重试配置 (TASK-4.3)
RATE_LIMIT_MUSE_RPM=30
RATE_LIMIT_TTS_RPM=60
API_MAX_RETRIES=3
API_RETRY_DELAY=2.0

# 社交平台发布码率预设 (TASK-4.4: default / xhs / douyin / wechat / bilibili)
PLATFORM_PRESET=default

# 图生视频混合微动模式 (TASK-5.0: static / i2v-tier1 / i2v-all)
MOTION_MODE=static
